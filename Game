from ursina import *

app = Ursina()

# Create a basic 3D player entity (cube)
player = Entity(
    model='cube',
    color=color.orange,
    scale=(1, 1, 1),
    position=(0, 1, 0)
)

# Ground
ground = Entity(
    model='plane',
    scale=(10, 1, 10),
    texture='white_cube',
    color=color.gray,
    collider='box'
)

camera.position = (0, 10, -20)
camera.rotation_x = 30

def update():
    speed = 5 * time.dt
    rotate_speed = 100 * time.dt
    
    if held_keys['left arrow']:
        player.x -= speed
        player.rotation_y += rotate_speed
    if held_keys['right arrow']:
        player.x += speed
        player.rotation_y -= rotate_speed
    if held_keys['up arrow']:
        player.z += speed
        player.rotation_x += rotate_speed
    if held_keys['down arrow']:
        player.z -= speed
        player.rotation_x -= rotate_speed

app.run()
